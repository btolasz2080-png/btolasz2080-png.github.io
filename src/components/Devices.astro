---
// Laptop + phone mockups. They tilt in 3D and separate in depth when the
// mouse moves over them (see scripts/tilt.ts). Drop real screenshots into
// /public/images and reference them from the project's front-matter.
import { url } from '../lib/url';
interface Props {
  title: string;
  accent?: 'burgundy' | 'blue' | 'espresso' | 'mocha';
  desktopImage?: string;
  mobileImage?: string;
  size?: 'lg' | 'md';
  interactive?: boolean;
}
const { title, accent = 'burgundy', desktopImage, mobileImage, size = 'md', interactive = true } = Astro.props;
---
<div class={`devices devices-${size} acc-${accent}`} data-tilt={interactive ? '' : undefined} aria-hidden="true">
  <div class="dev-shadow" data-depth="-10"></div>
  <div class="laptop" data-depth="16">
    <div class="laptop-lid">
      <div class="screen">
        {desktopImage ? <img src={url(desktopImage)} alt="" loading="lazy" /> : (
          <div class="ui">
            <div class="ui-bar"><i></i><i></i><i></i><span></span></div>
            <div class="ui-body">
              <div class="ui-nav"><b></b><span></span><span></span><span></span></div>
              <div class="ui-hero">
                <p class="ui-title">{title}</p>
                <span class="ui-line"></span><span class="ui-line short"></span>
                <span class="ui-btn"></span>
              </div>
              <div class="ui-grid"><span></span><span></span><span></span></div>
            </div>
          </div>
        )}
      </div>
    </div>
    <div class="laptop-base"><span></span></div>
  </div>
  <div class="phone" data-depth="44">
    <div class="screen">
      {mobileImage ? <img src={url(mobileImage)} alt="" loading="lazy" /> : (
        <div class="ui ui-m">
          <div class="ui-notch"></div>
          <p class="ui-title">{title}</p>
          <span class="ui-line"></span><span class="ui-line short"></span>
          <div class="ui-card"></div><div class="ui-card alt"></div>
          <span class="ui-btn"></span>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .devices {
    --acc: var(--burgundy); --acc-ink: var(--beige); --acc-soft: var(--blue);
    position: relative; width: 100%; aspect-ratio: 16 / 11;
    transform-style: preserve-3d;
  }
  .acc-blue { --acc: var(--blue); --acc-ink: var(--espresso); --acc-soft: var(--burgundy); }
  .acc-espresso { --acc: var(--espresso); --acc-ink: var(--beige); --acc-soft: var(--blue); }
  .acc-mocha { --acc: var(--mocha); --acc-ink: var(--beige); --acc-soft: var(--blue); }

  .laptop { position: absolute; left: 4%; top: 6%; width: 80%; transform-style: preserve-3d; }
  .laptop-lid { background: #140603; border-radius: 12px 12px 4px 4px; padding: 2.2%; box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }
  .laptop .screen { aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; background: var(--paper); }
  .laptop-base { position: relative; height: 0; padding-top: 4.2%; margin: 0 -7%; background: linear-gradient(#cfc7b1, #9f967d); border-radius: 0 0 14px 14px; clip-path: polygon(0 0, 100% 0, 97% 100%, 3% 100%); }
  .laptop-base span { position: absolute; left: 42%; right: 42%; top: 0; height: 35%; background: rgba(0,0,0,.18); border-radius: 0 0 6px 6px; }
  .phone { position: absolute; right: 3%; bottom: 3%; width: 21%; background: #140603; border-radius: 18% / 9%; padding: 2.2% 1.8%; box-shadow: inset 0 0 0 1px rgba(255,255,255,.1), 0 24px 40px -12px rgba(26,9,5,.45); }
  .phone .screen { aspect-ratio: 9 / 19.5; border-radius: 14% / 6.5%; overflow: hidden; background: var(--paper); }
  .screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .dev-shadow { position: absolute; left: 8%; right: 8%; bottom: -2%; height: 12%; background: radial-gradient(closest-side, rgba(26,9,5,.35), transparent); filter: blur(6px); }

  /* Placeholder UI drawn with the project's accent colour */
  .ui { height: 100%; display: flex; flex-direction: column; font-family: var(--serif); }
  .ui-bar { display: flex; align-items: center; gap: 4px; padding: 2.2% 3%; background: var(--beige-2); }
  .ui-bar i { width: 6px; height: 6px; border-radius: 50%; background: rgba(26,9,5,.25); }
  .ui-bar span { flex: 1; height: 7px; margin-left: 8%; margin-right: 30%; border-radius: 4px; background: rgba(26,9,5,.1); }
  .ui-body { flex: 1; display: flex; flex-direction: column; padding: 3% 5%; gap: 7%; }
  .ui-nav { display: flex; gap: 6%; align-items: center; }
  .ui-nav b { width: 9%; height: 6px; background: var(--acc); border-radius: 2px; }
  .ui-nav span { width: 7%; height: 4px; background: rgba(26,9,5,.2); border-radius: 2px; }
  .ui-nav span:first-of-type { margin-left: auto; }
  .ui-hero { display: grid; gap: 6px; }
  .ui-title { margin: 0; font-size: clamp(.8rem, 2.1vw, 1.7rem); line-height: 1; color: var(--espresso); font-weight: 500; }
  .devices-md .ui-title { font-size: clamp(.7rem, 1.5vw, 1.25rem); }
  .ui-line { display: block; height: 5px; width: 62%; border-radius: 3px; background: rgba(26,9,5,.16); }
  .ui-line.short { width: 40%; }
  .ui-btn { display: block; width: 18%; height: 10px; border-radius: 99px; background: var(--acc); margin-top: 4px; }
  .ui-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4%; flex: 1; }
  .ui-grid span { border-radius: 4px; background: var(--acc); opacity: .9; }
  .ui-grid span:nth-child(2) { background: var(--acc-soft); }
  .ui-grid span:nth-child(3) { background: var(--beige-2); }
  .ui-m { padding: 10% 9%; gap: 5%; }
  .ui-m .ui-title { font-size: clamp(.5rem, .9vw, .8rem); }
  .ui-notch { width: 36%; height: 4%; margin: -6% auto 6%; border-radius: 99px; background: #140603; }
  .ui-m .ui-line { height: 3px; width: 80%; }
  .ui-card { flex: 1; border-radius: 8px; background: var(--acc); }
  .ui-card.alt { flex: .6; background: var(--acc-soft); }
  .ui-m .ui-btn { width: 60%; height: 8px; }
</style>
