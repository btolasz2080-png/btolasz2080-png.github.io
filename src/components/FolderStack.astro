---
// Stacked file folders inspired by "The color archive".
// Hover a folder: the folders in front slide down to reveal it.
// Click: it opens (navigates) with the chessboard transition.
import { url } from '../lib/url';

export interface Folder {
  label: string;
  href: string;
  color: 'mocha' | 'blue' | 'burgundy' | 'paper' | 'espresso';
  meta?: string;   // e.g. "04 files"
  teaser?: string; // short sentence revealed on hover
}
interface Props { items: Folder[]; class?: string; compact?: boolean }
const { items, class: cls = '', compact = false } = Astro.props;
const hex = { mocha: '#3A2119', blue: '#94B1C8', burgundy: '#4C050C', paper: '#ECE9DD', espresso: '#1A0905' };
const tabX = [12, 46, 30, 62, 20, 54];
---
<nav class={`folders ${compact ? 'compact' : ''} ${cls}`} data-folders aria-label="Archive folders">
  {items.map((f, i) => (
    <a class={`folder f-${f.color}`} href={url(f.href)} style={`--i:${i};--tab-x:${tabX[i % tabX.length]}%;z-index:${i + 1}`} data-folder data-cursor="Open">
      <span class="folder-tab" data-folder-tab><span>{f.label}</span></span>
      <span class="folder-body">
        <span class="folder-row">
          <span class="folder-code">{hex[f.color]}</span>
          {f.meta && <span class="folder-meta">{f.meta}</span>}
        </span>
        {f.teaser && <span class="folder-teaser">{f.teaser}</span>}
        <span class="folder-open">Open folder <span aria-hidden="true">→</span></span>
      </span>
    </a>
  ))}
</nav>

<style>
  .folders { --step: 96px; --body: 230px; position: relative; padding-top: 48px; padding-bottom: calc(var(--body) - var(--step)); }
  .folders.compact { --step: 86px; --body: 200px; }
  .folder {
    --fbg: var(--mocha); --fink: var(--beige);
    position: relative; display: block; height: var(--step);
    color: var(--fink);
    will-change: transform;
  }
  .f-blue { --fbg: var(--blue); --fink: var(--espresso); }
  .f-burgundy { --fbg: var(--burgundy); --fink: var(--beige); }
  .f-paper { --fbg: var(--paper); --fink: var(--espresso); }
  .f-espresso { --fbg: var(--espresso); --fink: var(--beige); }

  .folder-tab {
    position: absolute; bottom: 100%; left: var(--tab-x);
    margin-bottom: -1px;
    min-width: clamp(150px, 22vw, 260px);
    height: 46px; padding: 0 2.4em;
    display: grid; place-items: center;
    background: var(--fbg);
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
    border-radius: 10px 10px 0 0;
    font-size: .78rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase;
    will-change: transform;
  }
  .folder-body {
    position: absolute; left: 0; right: 0; top: 0; height: var(--body);
    background: var(--fbg);
    border-radius: 6px 6px 0 0;
    padding: 22px clamp(18px, 3vw, 36px);
    display: grid; align-content: start; gap: 14px;
    box-shadow: 0 -10px 24px -14px rgba(26, 9, 5, .45);
  }
  .f-paper .folder-body, .f-paper .folder-tab { box-shadow: inset 0 1px 0 rgba(26, 9, 5, .08); }
  .folder:last-child .folder-body { border-radius: 6px; }
  .folder-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .folder-code, .folder-meta { font-family: var(--mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; opacity: .75; }
  .folder-teaser { font-family: var(--serif); font-size: clamp(1.4rem, 2.6vw, 2.2rem); line-height: 1.05; max-width: 26ch; opacity: 0; transform: translateY(10px); transition: opacity .5s var(--ease), transform .6s var(--ease); }
  .folder-open { font-family: var(--mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; opacity: 0; transition: opacity .5s var(--ease) .05s; }
  .folder.is-open .folder-teaser, .folder:focus-visible .folder-teaser { opacity: 1; transform: none; }
  .folder.is-open .folder-open, .folder:focus-visible .folder-open { opacity: .85; }
  @media (hover: none) {
    .folder-teaser { opacity: 1; transform: none; font-size: 1.15rem; }
    .folder-open { opacity: .8; }
  }
  @media (max-width: 600px) {
    .folders { --step: 84px; }
    .folder-tab { min-width: 132px; padding: 0 1.4em; font-size: .68rem; letter-spacing: .12em; }
    .folder:nth-child(n) .folder-tab { left: calc(var(--tab-x) * .6); }
  }
</style>
