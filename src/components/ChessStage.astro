---
// The hero chessboard. The board tilts with the mouse; hover the gold queen
// to see her legal moves, then click a highlighted square to move her.
// Logic lives in scripts/chess.ts.
import Piece from './Piece.astro';
import Seal from './Seal.astro';

const files = 'abcdefgh';
const squares = Array.from({ length: 64 }, (_, i) => ({ r: Math.floor(i / 8), c: i % 8 }));

// Starting position: [row, col, type, tone]
const pieces: { r: number; c: number; type: 'pawn' | 'rook'; tone: 'ivory' | 'ebony' | 'wine' }[] = [
  { r: 1, c: 1, type: 'pawn', tone: 'ebony' },
  { r: 1, c: 5, type: 'pawn', tone: 'ebony' },
  { r: 0, c: 6, type: 'rook', tone: 'ebony' },
  { r: 2, c: 3, type: 'pawn', tone: 'wine' },
  { r: 6, c: 6, type: 'pawn', tone: 'ivory' },
  { r: 6, c: 1, type: 'pawn', tone: 'ivory' },
  { r: 7, c: 0, type: 'rook', tone: 'ivory' },
];
---
<div class="chess" data-chess>
  <div class="chess-stage" data-chess-stage>
    <div class="board" data-board>
      {squares.map(({ r, c }) => (
        <div class={`sq ${(r + c) % 2 ? 'dk' : 'lt'}`} data-r={r} data-c={c} aria-hidden="true">
          <span class="dot"></span>
          {c === 0 && <em class="coord rank">{8 - r}</em>}
          {r === 7 && <em class="coord file">{files[c]}</em>}
        </div>
      ))}
      {pieces.map((p) => (
        <div class="pos" style={`--r:${p.r};--c:${p.c}`} data-piece data-r={p.r} data-c={p.c}>
          <div class={`stand stand-${p.type}`}><div class="lift"><Piece type={p.type} tone={p.tone} /></div></div>
        </div>
      ))}
      <div class="pos queen-pos" style="--r:4;--c:3" data-queen data-r="4" data-c="3">
        <div class="stand stand-queen">
          <button class="lift queen-btn" type="button" aria-label="The queen — press to make a move" data-cursor="Move">
            <Piece type="queen" tone="gold" />
            <span class="queen-glow"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <p class="chess-hint mono"><span class="pulse"></span> Hover the queen · click a square</p>
  <div class="chess-seal"><Seal /></div>
</div>

<style>
  .chess { position: relative; width: 100%; display: grid; place-items: center; }
  .chess-stage { perspective: 1100px; perspective-origin: 50% 20%; width: 100%; display: grid; place-items: center; padding: 8% 0 2%; }
  .board {
    --tilt: 54;
    --spin: 0;
    position: relative;
    width: min(440px, 78vw);
    aspect-ratio: 1;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    transform: rotateX(calc(var(--tilt) * 1deg)) rotateZ(calc(var(--spin) * 1deg));
    transform-style: preserve-3d;
    border-radius: 3px;
    box-shadow: 0 0 0 10px var(--espresso), 0 0 0 11px rgba(201, 165, 94, .6), 0 60px 70px -10px rgba(26, 9, 5, .45);
  }
  .sq { position: relative; display: grid; place-items: center; transition: filter .3s; }
  .sq.lt { background: var(--blue); }
  .sq.dk { background: var(--burgundy); }
  .sq:hover { filter: brightness(1.08); }
  .sq.legal { cursor: pointer; }
  .dot { width: 30%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #F3E2AE, #A27A33); box-shadow: 0 0 12px rgba(243, 226, 174, .6); transform: scale(0); opacity: 0; pointer-events: none; }
  .coord { position: absolute; font-style: normal; font-family: var(--mono); font-size: 8px; opacity: .55; pointer-events: none; }
  .coord.rank { left: 3px; top: 2px; }
  .coord.file { right: 3px; bottom: 1px; }
  .sq.lt .coord { color: var(--burgundy); }
  .sq.dk .coord { color: var(--blue); }

  .pos { position: absolute; left: calc((var(--c) + .5) * 12.5%); top: calc((var(--r) + .5) * 12.5%); width: 12.5%; height: 0; transform-style: preserve-3d; pointer-events: none; }
  .stand { position: absolute; left: 50%; bottom: 0; width: 86%; transform: translateX(-50%) rotateX(calc(var(--tilt) * -1deg)); transform-origin: 50% 100%; transform-style: preserve-3d; }
  .stand-rook { width: 92%; }
  .stand-queen { width: 140%; }
  .lift { display: block; width: 100%; }
  .lift :global(svg) { width: 100%; height: auto; filter: drop-shadow(0 6px 5px rgba(26, 9, 5, .35)); }
  .queen-btn { position: relative; pointer-events: auto; cursor: pointer; border-radius: 40% 40% 10% 10%; }
  .queen-glow { position: absolute; left: 10%; right: 10%; bottom: -4%; height: 16%; border-radius: 50%; background: radial-gradient(closest-side, rgba(243, 226, 174, .9), transparent); opacity: 0; pointer-events: none; }

  .chess-hint { margin: 1.4rem 0 0; color: var(--ink-soft); display: inline-flex; align-items: center; gap: .7em; font-size: .68rem; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--burgundy); box-shadow: 0 0 0 0 rgba(76, 5, 12, .5); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(76, 5, 12, 0); } 100% { box-shadow: 0 0 0 0 rgba(76, 5, 12, 0); } }
  .chess-seal { position: absolute; left: -2%; bottom: -2%; }
  @media (max-width: 900px) {
    .chess-seal { left: auto; right: 0; bottom: auto; top: 0; transform: scale(.62); transform-origin: top right; right: 8px; }
  }
</style>
