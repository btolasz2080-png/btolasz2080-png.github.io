---
// The round medallion ("the plate") — a burgundy seal with the gold queen,
// ringed by rotating text. Spins slowly and speeds up while you scroll.
import { site } from '../data/site';
interface Props { class?: string; text?: string }
const { class: cls = '', text = `${site.title} • Portfolio • MMXXVI • ` } = Astro.props;
---
<div class={`seal ${cls}`} data-seal aria-hidden="true">
  <svg class="seal-ring" viewBox="0 0 200 200">
    <defs>
      <path id="seal-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
      <linearGradient id="seal-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#A27A33" /><stop offset=".5" stop-color="#F0DDA4" /><stop offset="1" stop-color="#9C7630" />
      </linearGradient>
    </defs>
    <circle cx="100" cy="100" r="99" fill="#4C050C" />
    <circle cx="100" cy="100" r="92" fill="none" stroke="url(#seal-gold)" stroke-width=".8" />
    <circle cx="100" cy="100" r="62" fill="none" stroke="url(#seal-gold)" stroke-width=".8" />
    <text fill="url(#seal-gold)" font-family="JetBrains Mono, monospace" font-size="10.5" letter-spacing="3.2">
      <textPath href="#seal-circle">{text.toUpperCase()}</textPath>
    </text>
  </svg>
  <svg class="seal-core" viewBox="0 0 100 100">
    <line x1="26" y1="30" x2="74" y2="30" stroke="#D9BD7A" stroke-width=".8" />
    <line x1="26" y1="74" x2="74" y2="74" stroke="#D9BD7A" stroke-width=".8" />
    <g transform="translate(36 31) scale(.28)" fill="url(#seal-gold)">
      <path d="M35 76 Q43 84 43 98 Q43 118 30 138 L70 138 Q57 118 57 98 Q57 84 65 76 Z" />
      <path d="M22 40 L33 70 L67 70 L78 40 L67 55 L65 30 L57 52 L50 24 L43 52 L35 30 L33 55 Z" />
      <rect x="30" y="67" width="40" height="9" rx="3.5" />
      <circle cx="50" cy="15" r="6.5" /><circle cx="22" cy="38" r="3.8" /><circle cx="35" cy="28" r="3.8" /><circle cx="65" cy="28" r="3.8" /><circle cx="78" cy="38" r="3.8" />
      <path d="M24 138 H76 Q81 138 81 143 V147 H19 V143 Q19 138 24 138 Z" />
    </g>
  </svg>
</div>

<style>
  .seal { position: relative; width: 132px; aspect-ratio: 1; filter: drop-shadow(0 14px 22px rgba(26, 9, 5, .28)); }
  .seal svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seal-core { inset: 22% !important; width: 56% !important; height: 56% !important; }
</style>
