---
// A designed certificate "paper". If you add a real certificate image in the
// front-matter (image: /images/certs/xyz.jpg) it is shown instead.
import { url, formatDate } from '../lib/url';
import { site } from '../data/site';
interface Props { title: string; issuer: string; issued: Date; image?: string; large?: boolean }
const { title, issuer, issued, image, large = false } = Astro.props;
---
<div class={`cert ${large ? 'cert-lg' : ''}`}>
  {image ? <img src={url(image)} alt={`Certificate: ${title}`} loading="lazy" /> : (
    <div class="cert-paper" aria-hidden="true">
      <div class="cert-frame">
        <p class="cert-k">Certificate of Completion</p>
        <p class="cert-name script">{site.name}</p>
        <p class="cert-for">has successfully completed</p>
        <p class="cert-title">{title}</p>
        <div class="cert-foot">
          <span>{issuer}</span>
          <span class="cert-seal"></span>
          <span>{formatDate(issued, 'long')}</span>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .cert { aspect-ratio: 1.414; width: 100%; border-radius: 6px; overflow: hidden; box-shadow: 0 30px 50px -24px rgba(26, 9, 5, .45); background: #F5F1E4; }
  .cert img { width: 100%; height: 100%; object-fit: cover; }
  .cert-paper { height: 100%; padding: 4.5%; background: radial-gradient(circle at 30% 20%, #FBF8EE, #EFE9D6); }
  .cert-frame { height: 100%; border: 1px solid rgba(142, 107, 39, .6); outline: 1px solid rgba(142, 107, 39, .35); outline-offset: -6px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 5%; gap: 3%; container-type: inline-size; }
  .cert-k { margin: 0; font-family: var(--mono); font-size: 3.2cqi; letter-spacing: .22em; text-transform: uppercase; color: var(--burgundy); }
  .cert-name { margin: 0; font-size: 10cqi; line-height: 1.1; color: var(--gold-solid); }
  .cert-for { margin: 0; font-size: 3cqi; color: var(--ink-soft); font-style: italic; font-family: var(--serif); }
  .cert-title { margin: 0; font-family: var(--serif); font-weight: 600; font-size: 6.4cqi; line-height: 1.05; color: var(--espresso); max-width: 90%; }
  .cert-foot { width: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4%; margin-top: 3%; font-family: var(--mono); font-size: 2.4cqi; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .cert-seal { width: 11cqi; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F0DDA4, #A27A33 60%, #6B4A12); box-shadow: 0 0 0 2px #4C050C; }
</style>
