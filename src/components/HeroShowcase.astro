---
// Hero devices (like a product showcase): a browser window, a phone and a tablet
// showing your projects. They float and drift in 3D with the mouse.
// Each device shows one of your folders (courses, certificates...).
import Screen from './Screen.astro';
import { url } from '../lib/url';
export interface Show { title: string; href: string; accent: 'burgundy' | 'blue' | 'espresso' | 'mocha'; image?: string; mobileImage?: string; domain?: string }
interface Props { items: Show[] }
const [a, b, c] = Astro.props.items;
---
<div class="showcase" data-showcase aria-label="My folders">
  {c && (
    <a class="dev tablet" href={url(c.href)} data-layer="18" data-float="3.6" data-cursor="Open">
      <span class="tablet-frame"><Screen title={c.title} image={c.image} accent={c.accent} /></span>
    </a>
  )}
  {a && (
    <a class="dev browser" href={url(a.href)} data-layer="34" data-float="4.2" data-cursor="Open">
      <span class="browser-bar"><i></i><i></i><i></i><em>{a.domain ?? a.title.toLowerCase().replace(/\s+/g, '-')}</em></span>
      <span class="browser-screen"><Screen title={a.title} image={a.image} accent={a.accent} /></span>
    </a>
  )}
  {b && (
    <a class="dev phone" href={url(b.href)} data-layer="70" data-float="3.2" data-cursor="Open">
      <span class="phone-frame"><Screen title={b.title} kind="mobile" image={b.mobileImage} accent={b.accent} /></span>
    </a>
  )}
  <span class="glow" data-layer="-20" aria-hidden="true"></span>
</div>

<style>
  .showcase { position: relative; width: 100%; aspect-ratio: 1 / .95; perspective: 1400px; }
  .dev { position: absolute; display: block; will-change: transform; transform-style: preserve-3d; border-radius: 14px; transition: box-shadow .5s var(--ease); }
  .glow { position: absolute; inset: 15% 10% 10% 15%; border-radius: 50%; background: radial-gradient(closest-side, rgba(148, 177, 200, .55), transparent 70%); filter: blur(10px); z-index: 0; }
  .browser {
    left: 4%; top: 12%; width: 76%; z-index: 2;
    background: #F7F4EA; border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .8) inset, 0 40px 80px -30px rgba(26, 9, 5, .55), 0 0 0 1px rgba(26, 9, 5, .08);
  }
  .browser-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #E9E4D4; border-bottom: 1px solid rgba(26, 9, 5, .08); }
  .browser-bar i { width: 9px; height: 9px; border-radius: 50%; background: #C9BFA4; }
  .browser-bar i:first-child { background: #4C050C; opacity: .7; }
  .browser-bar em { margin-left: 12px; flex: 1; max-width: 60%; font-style: normal; font-family: var(--mono); font-size: .64rem; color: rgba(26, 9, 5, .55); background: rgba(255, 255, 255, .7); border-radius: 6px; padding: 3px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .browser-screen { display: block; aspect-ratio: 16 / 10.5; }
  .phone {
    right: 2%; bottom: 4%; width: 25%; z-index: 3;
    background: #120502; padding: 2.4%; border-radius: 28px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .08) inset, 0 50px 70px -24px rgba(26, 9, 5, .65);
  }
  .phone-frame { display: block; aspect-ratio: 9 / 19.5; border-radius: 22px; overflow: hidden; }
  .tablet {
    right: 0; top: 0; width: 44%; z-index: 1;
    background: #2B150D; padding: 2%; border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(26, 9, 5, .5);
    opacity: .9;
  }
  .tablet-frame { display: block; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; }
  .dev:hover { z-index: 5; }
  @media (max-width: 900px) { .showcase { max-width: 560px; margin: 0 auto; } }
</style>
