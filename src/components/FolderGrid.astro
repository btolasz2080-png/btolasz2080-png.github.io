---
// Separate, realistic file folders. Hover: the front flap tips open and the
// papers inside rise so you can read what's in the folder. Click to open it.
import { url } from '../lib/url';

export interface Folder {
  label: string;
  href: string;
  color: 'mocha' | 'blue' | 'burgundy' | 'paper' | 'espresso';
  meta?: string;
  papers?: string[]; // titles printed on the sheets inside
  teaser?: string;
}
interface Props { items: Folder[]; columns?: 2 | 3 | 4 }
const { items, columns = 3 } = Astro.props;
const hex = { mocha: '#3A2119', blue: '#94B1C8', burgundy: '#4C050C', paper: '#ECE9DD', espresso: '#1A0905' };
---
<div class={`fgrid cols-${columns}`}>
  {items.map((f, i) => (
    <a class={`fld f-${f.color}`} href={url(f.href)} data-fld data-cursor="Open" data-reveal style={`--tab:${[8, 38, 22, 52][i % 4]}%`}>
      <span class="fld-back"><span class="fld-tab">{f.label}</span></span>
      <span class="fld-papers" data-fld-papers>
        {(f.papers?.length ? f.papers : ['', '', '']).slice(0, 3).reverse().map((p, j) => (
          <span class="paper" style={`--j:${j}`}><b>{p}</b><i></i><i></i><i class="s"></i></span>
        ))}
      </span>
      <span class="fld-front" data-fld-front>
        <span class="fld-row"><span class="mono">{hex[f.color]}</span>{f.meta && <span class="mono">{f.meta}</span>}</span>
        <span class="fld-name">{f.label}</span>
        {f.teaser && <span class="fld-teaser">{f.teaser}</span>}
        <span class="fld-open mono">Open folder →</span>
      </span>
    </a>
  ))}
</div>

<style>
  .fgrid { display: grid; gap: clamp(28px, 4vw, 48px) clamp(18px, 3vw, 36px); }
  .cols-2 { grid-template-columns: repeat(2, 1fr); }
  .cols-3 { grid-template-columns: repeat(3, 1fr); }
  .cols-4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1000px) { .cols-3, .cols-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .fgrid { grid-template-columns: 1fr !important; } }

  .fld {
    --fbg: var(--mocha); --fink: var(--beige); --fdark: #24130D;
    position: relative; display: block; aspect-ratio: 1.18; perspective: 900px;
    padding-top: 34px; color: var(--fink);
  }
  .f-blue { --fbg: #94B1C8; --fink: var(--espresso); --fdark: #6F8EA7; }
  .f-burgundy { --fbg: #4C050C; --fink: var(--beige); --fdark: #2E0207; }
  .f-paper { --fbg: #E8E2CF; --fink: var(--espresso); --fdark: #C9C0A6; }
  .f-espresso { --fbg: #1A0905; --fink: var(--beige); --fdark: #0A0302; }
  .f-mocha { --fdark: #24130D; }

  /* back panel + tab */
  .fld-back { position: absolute; inset: 34px 0 0; background: linear-gradient(var(--fdark), var(--fbg) 40%); border-radius: 4px 10px 10px 10px; box-shadow: 0 24px 40px -22px rgba(26, 9, 5, .6); }
  .fld-tab {
    position: absolute; bottom: 100%; left: var(--tab); height: 34px; padding: 0 1.8em;
    display: grid; place-items: center; background: var(--fdark);
    clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%); border-radius: 8px 8px 0 0;
    font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 500; white-space: nowrap; color: var(--fink);
  }
  /* papers */
  .fld-papers { position: absolute; left: 6%; right: 6%; top: 44px; bottom: 10%; }
  .paper {
    position: absolute; inset: 0; background: #FBF8EF; border-radius: 3px;
    box-shadow: 0 2px 6px rgba(26, 9, 5, .18);
    padding: 12% 9% 0; display: grid; align-content: start; gap: 7px;
    transform: translate(calc(var(--j) * 7px), calc(var(--j) * 8px)) rotate(calc((var(--j) - 1) * 1.4deg));
    color: var(--espresso);
  }
  .paper b { font-family: var(--serif); font-weight: 600; font-size: .95rem; line-height: 1.1; min-height: 1.1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .paper i { display: block; height: 4px; width: 80%; background: rgba(26, 9, 5, .12); border-radius: 2px; }
  .paper i.s { width: 50%; }
  /* front flap */
  .fld-front {
    position: absolute; left: 0; right: 0; bottom: 0; height: 74%;
    background: linear-gradient(170deg, color-mix(in srgb, var(--fbg) 88%, white), var(--fbg) 45%);
    border-radius: 6px 6px 10px 10px;
    transform-origin: 50% 100%;
    box-shadow: 0 -6px 16px -8px rgba(26, 9, 5, .35), inset 0 1px 0 rgba(255, 255, 255, .18);
    padding: clamp(14px, 2vw, 22px); display: grid; align-content: start; gap: 6px;
    will-change: transform;
  }
  .fld-row { display: flex; justify-content: space-between; gap: 1rem; opacity: .75; font-size: .62rem; }
  .fld-row .mono { font-size: .62rem; }
  .fld-name { font-family: var(--serif); font-size: clamp(1.7rem, 2.6vw, 2.4rem); line-height: 1; margin-top: .3rem; }
  .fld-teaser { font-size: .88rem; opacity: .8; line-height: 1.4; max-width: 30ch; }
  .fld-open { position: absolute; left: clamp(14px, 2vw, 22px); bottom: clamp(12px, 1.6vw, 18px); font-size: .64rem; opacity: .7; }
</style>
