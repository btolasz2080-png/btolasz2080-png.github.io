---
import { site, nav } from '../data/site';
import { url } from '../lib/url';
import Piece from './Piece.astro';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => href !== '/' && path.startsWith(href.replace(/\/$/, ''));
---
<header class:list={['site-header', { 'on-dark': dark }]} data-header>
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${site.name} — home`}>
      <span class="brand-mark"><Piece type="queen" tone="gold" /></span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="links" aria-label="Main">
      {nav.map((n) => (
        <a href={url(n.href)} class="link-line" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="btn talk" href={url('/contact/')} data-magnetic>Let's talk <span class="arrow" aria-hidden="true">→</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="sr-only">Menu</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="menu dark" id="menu" data-menu hidden>
  <div class="wrap menu-inner">
    <p class="square-tag">Choose your move</p>
    <nav aria-label="Mobile">
      {[{ label: 'Home', href: '/' }, ...nav].map((n, i) => (
        <a href={url(n.href)} class="menu-link" data-menu-link>
          <span class="mono">0{i + 1}</span><span class="gold">{n.label}</span>
        </a>
      ))}
    </nav>
    <p class="menu-foot mono">{site.email}</p>
  </div>
</div>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background .4s, box-shadow .4s; }
  .site-header { color: var(--ink); }
  .site-header.on-dark:not(.scrolled) { --ink: var(--beige); --ink-soft: rgba(227, 223, 206, .7); }
  .site-header.on-dark:not(.scrolled) .talk { --btn-bg: var(--beige); --btn-fg: var(--espresso); }
  .site-header.on-dark:not(.scrolled) .talk:hover { --btn-fg: var(--beige); }
  .site-header.scrolled { background: rgba(227, 223, 206, .82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--line); }
  .bar { display: flex; align-items: center; gap: 2rem; height: 76px; }
  .brand { display: inline-flex; align-items: center; gap: .75rem; margin-right: auto; }
  .brand-mark { width: 40px; height: 40px; border-radius: 50%; background: var(--burgundy); display: grid; place-items: center; overflow: hidden; transition: transform .6s var(--ease); }
  .brand-mark :global(svg) { width: 54%; margin-top: 4px; }
  .brand:hover .brand-mark { transform: rotate(-12deg) scale(1.06); }
  .brand-name { font-family: var(--serif); font-size: 1.35rem; font-weight: 600; letter-spacing: .005em; }
  .links { display: flex; gap: 1.8rem; font-size: .92rem; }
  .links a { color: var(--ink-soft); transition: color .3s; }
  .links a:hover, .links a[aria-current='page'] { color: var(--ink); }
  .talk { padding: .7em 1.25em; font-size: .86rem; }
  .menu-btn { display: none; width: 46px; height: 46px; border-radius: 50%; background: var(--espresso); position: relative; z-index: 61; }
  .menu-btn i { position: absolute; left: 14px; right: 14px; height: 1.5px; background: var(--beige); transition: transform .5s var(--ease); }
  .menu-btn i:first-of-type { top: 19px; }
  .menu-btn i:last-of-type { top: 26px; }
  .menu-btn[aria-expanded='true'] i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }
  .menu { position: fixed; inset: 0; z-index: 49; padding-top: 110px; overflow-y: auto; }
  .menu-inner { display: grid; gap: 2rem; }
  .menu nav { display: grid; }
  .menu-link { display: flex; align-items: baseline; gap: 1.2rem; padding: .35rem 0; border-bottom: 1px solid var(--line); }
  .menu-link .mono { color: var(--ink-soft); }
  .menu-link .gold { font-family: var(--serif); font-size: clamp(2.4rem, 10vw, 3.6rem); line-height: 1.1; }
  .menu-foot { color: var(--ink-soft); }
  @media (max-width: 980px) {
    .links, .talk { display: none; }
    .menu-btn { display: block; }
  }
</style>
