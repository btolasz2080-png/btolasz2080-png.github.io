---
// Private "+ Add file" button. Hidden from visitors.
// Turn it on once on your device by opening:  https://<your-site>/?admin=1
// Turn it off with ?admin=0. It opens GitHub with a ready-to-fill file;
// only you (the repository owner) can save it there.
import { addUrl } from '../lib/admin';
const links = [
  { group: 'Projects', items: [{ label: 'New project', href: addUrl.project() }] },
  {
    group: 'Courses',
    items: [
      { label: 'New Cisco course', href: addUrl.cisco() },
      { label: 'New Coursera course', href: addUrl.coursera() },
      { label: 'New course (other platform)', href: addUrl.other() },
      { label: 'New folder (new platform)', href: addUrl.folder() },
    ],
  },
  { group: 'Certificates', items: [{ label: 'New certificate', href: addUrl.certificate() }] },
  {
    group: 'Images & files',
    items: [
      { label: 'Upload screenshots / photos', href: addUrl.upload() },
      { label: 'Upload certificate images', href: addUrl.upload('public/images/certs') },
      { label: 'Upload CV (name it cv.pdf)', href: addUrl.upload('public') },
      { label: 'Edit my details', href: addUrl.editDetails() },
    ],
  },
];
---
<div class="admin" data-admin hidden>
  <div class="admin-panel" id="admin-panel" data-admin-panel hidden>
    <p class="admin-title">Add to your portfolio</p>
    {links.map((g) => (
      <div class="admin-group">
        <p class="mono">{g.group}</p>
        {g.items.map((it) => <a href={it.href} target="_blank" rel="noopener">{it.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    ))}
    <p class="admin-note">Opens GitHub with a ready file. Fill it in and press <b>Commit changes</b>. The site updates itself in about 2 minutes, and your GitHub profile folders within an hour.</p>
  </div>
  <button type="button" class="admin-btn" data-admin-btn aria-expanded="false" aria-controls="admin-panel">
    <span class="plus" aria-hidden="true">+</span> Add file
  </button>
</div>

<script is:inline>
  (function () {
    var on = false;
    try {
      var q = new URLSearchParams(location.search).get('admin');
      if (q === '1') localStorage.setItem('portfolio-admin', '1');
      if (q === '0') localStorage.removeItem('portfolio-admin');
      on = localStorage.getItem('portfolio-admin') === '1';
    } catch (e) {}
    if (!on) return;
    var root = document.querySelector('[data-admin]');
    var btn = root.querySelector('[data-admin-btn]');
    var panel = root.querySelector('[data-admin-panel]');
    root.hidden = false;
    document.documentElement.classList.add('admin-on');
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  })();
</script>

<style>
  .admin { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: grid; justify-items: end; gap: 10px; }
  .admin-btn {
    display: inline-flex; align-items: center; gap: .55em; padding: .85em 1.3em; border-radius: 999px;
    background: var(--burgundy); color: var(--beige); font-weight: 500; font-size: .9rem;
    box-shadow: 0 14px 30px -10px rgba(76, 5, 12, .6), 0 0 0 1px rgba(201, 165, 94, .5);
    transition: transform .4s var(--ease);
  }
  .admin-btn:hover { transform: translateY(-2px); }
  .plus { font-size: 1.3em; line-height: 1; color: #E2C98A; transition: transform .4s var(--ease); }
  .admin-btn[aria-expanded='true'] .plus { transform: rotate(45deg); }
  .admin-panel {
    width: min(320px, calc(100vw - 36px)); max-height: 70vh; overflow-y: auto;
    background: var(--espresso); color: var(--beige); border-radius: 16px; padding: 18px;
    box-shadow: 0 30px 60px -20px rgba(26, 9, 5, .7);
    display: grid; gap: 14px;
  }
  .admin-title { margin: 0; font-family: var(--serif); font-size: 1.5rem; color: #E2C98A; }
  .admin-group { display: grid; gap: 2px; }
  .admin-group .mono { margin: 0 0 4px; font-size: .62rem; color: var(--blue); }
  .admin-group a { display: flex; justify-content: space-between; padding: 7px 10px; border-radius: 8px; font-size: .9rem; }
  .admin-group a:hover { background: rgba(227, 223, 206, .08); }
  .admin-note { margin: 0; font-size: .78rem; color: rgba(227, 223, 206, .65); line-height: 1.5; }
</style>
