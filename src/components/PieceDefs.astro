    <linearGradient id="pc-ivory" x1="0" y1="0" x2="1" y2="0.2">
      <stop offset="0" stop-color="#BDB394" />
      <stop offset="0.4" stop-color="#F4F0E2" />
      <stop offset="1" stop-color="#B3A887" />
    </linearGradient>
    <linearGradient id="pc-ebony" x1="0" y1="0" x2="1" y2="0.2">
      <stop offset="0" stop-color="#120502" />
      <stop offset="0.42" stop-color="#5A3326" />
      <stop offset="1" stop-color="#0E0402" />
