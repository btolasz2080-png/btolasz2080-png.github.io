  <defs>
    <linearGradient id="pc-gold" x1="0" y1="0" x2="1" y2="0.25">
      <stop offset="0" stop-color="#6B4A12" />
      <stop offset="0.28" stop-color="#C9A55E" />
      <stop offset="0.46" stop-color="#F3E2AE" />
      <stop offset="0.64" stop-color="#B08A3E" />
      <stop offset="1" stop-color="#5E400F" />
