---
// Container for the realistic 3D chessboard (see scripts/chess3d.ts).
---
<div class="c3d" data-chess3d>
  <div class="c3d-canvas" data-chess3d-canvas></div>
  <div class="c3d-ui">
    <p class="mono"><span class="pulse"></span> Hover the queen · click a glowing square</p>
    <button type="button" class="c3d-move mono" data-chess3d-move>Make a move ♛</button>
  </div>
  <p class="c3d-fallback">Your browser can't show the 3D board.</p>
</div>

<style>
  .c3d { position: relative; width: 100%; }
  .c3d-canvas { width: 100%; aspect-ratio: 1.15; cursor: grab; }
  .c3d-canvas :global(canvas) { width: 100% !important; height: 100% !important; display: block; }
  .c3d-ui { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .8rem 1.4rem; margin-top: .4rem; }
  .c3d-ui p { margin: 0; color: var(--ink-soft); font-size: .66rem; display: inline-flex; align-items: center; gap: .6em; }
  .c3d-move { font-size: .66rem; padding: .6em 1.1em; border-radius: 99px; border: 1px solid var(--line); color: var(--ink); transition: background .3s, color .3s; }
  .c3d-move:hover { background: var(--burgundy); color: var(--beige); border-color: var(--burgundy); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: #D9B064; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(217, 176, 100, .6); } 70% { box-shadow: 0 0 0 9px rgba(217, 176, 100, 0); } 100% { box-shadow: 0 0 0 0 rgba(217, 176, 100, 0); } }
  .c3d-fallback { display: none; }
  :global(.no-webgl) .c3d-fallback { display: block; text-align: center; color: var(--ink-soft); }
  @media (max-width: 700px) { .c3d-canvas { aspect-ratio: .95; } }
</style>
