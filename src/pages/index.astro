---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FolderGrid from '../components/FolderGrid.astro';
import CertificatePaper from '../components/CertificatePaper.astro';
import Seal from '../components/Seal.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import { url, formatDate, platforms, type PlatformKey } from '../lib/url';
import { addUrl } from '../lib/admin';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const courses = (await getCollection('courses')).sort((a, b) => +b.data.completed - +a.data.completed);
const certs = (await getCollection('certificates')).sort((a, b) => +b.data.issued - +a.data.issued);
const allSkills = skillGroups.flatMap((g) => g.items);
const pad = (n: number) => String(n).padStart(2, '0');

const headline = site.headline.map((line) =>
  line.split(/(\*[^*]+\*)/).filter(Boolean).map((part) => (part.startsWith('*') ? { accent: true, text: part.slice(1, -1) } : { accent: false, text: part })),
);

const courseFolder = (k: PlatformKey) => ({
  id: k,
  label: platforms[k].label,
  color: platforms[k].folder,
  href: `/courses/${k}/`,
  addHref: addUrl[k](),
  addLabel: 'Add course',
  items: courses.filter((c) => c.data.platform === k).map((c) => ({ title: c.data.title, href: `/courses/${k}/`, meta: `${c.data.provider} · ${formatDate(c.data.completed)}` })),
});

const folders = [
  courseFolder('cisco'),
  courseFolder('coursera'),
  courseFolder('other'),
  {
    id: 'certificates', label: 'Certificates', color: 'paper', href: '/certificates/', addHref: addUrl.certificate(), addLabel: 'Add certificate',
    items: certs.map((c) => ({ title: c.data.title, href: `/certificates/${c.id}/`, meta: `${c.data.issuer} · ${formatDate(c.data.issued)}` })),
  },
  {
    id: 'projects', label: 'Projects', color: 'espresso', href: '/projects/', addHref: addUrl.project(), addLabel: 'Add project',
    items: projects.map((p) => ({ title: p.data.title, href: `/projects/${p.id}/`, meta: `${p.data.category} · ${p.data.year}` })),
    empty: 'My college projects are being uploaded to GitHub — coming soon.',
  },
];
---
<Base darkHeader>
  <!-- ───────────── HERO: the binary queen ───────────── -->
  <section class="hero dark" data-hero>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-in>{site.eyebrow.join(' · ')}</p>
        <h1 class="display hero-title" data-hero-split>
          {headline.map((parts) => (
            <span class="hl-line">{parts.map((p) => (p.accent ? <span class="accent">{p.text}</span> : <span class="gold">{p.text}</span>))}</span>
          ))}
        </h1>
        <p class="lead hero-intro" data-hero-in>Hi, I'm <strong>{site.name}</strong>. {site.intro}</p>
        <div class="hero-actions" data-hero-in>
          <a class="btn" href="#files" data-magnetic>Open my files <span class="arrow" aria-hidden="true">↓</span></a>
          <a class="btn ghost" href={site.github} target="_blank" rel="noopener" data-magnetic>GitHub profile</a>
        </div>
        <p class="hero-status mono" data-hero-in><span class="live"></span>{site.availability}</p>
      </div>
      <div class="hero-visual" data-hero-in>
        <div class="bq" data-binary-queen></div>
        <p class="bq-hint mono">♛ move your mouse through the queen · click for a ripple</p>
      </div>
    </div>
  </section>

  <!-- ───────────── FILES (drop-down folders) ───────────── -->
  <section class="section" id="files">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="square-tag" data-reveal>01 — My files</p>
          <h2 class="h2" data-split><span class="gold">Everything I learn,</span> <span class="accent">filed.</span></h2>
        </div>
        <p class="lead" data-reveal>Click a folder to open it. The files drop down underneath.</p>
      </div>
      <FolderGrid items={folders as any} columns={5} />
    </div>
  </section>

  <!-- ───────────── ABOUT ───────────── -->
  <section class="section about-strip dark wine" id="about">
    <div class="wrap about-grid">
      <div class="about-copy">
        <p class="square-tag" data-reveal>02 — About</p>
        <h2 class="h2" data-split><span class="gold">Small moves,</span> <span class="accent">every day.</span></h2>
        {site.about.story.slice(0, 2).map((p) => <p class="lead" data-reveal>{p}</p>)}
        <a class="btn" href={url('/about/')} data-magnetic data-reveal>More about me <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="moves">
        {site.about.timeline.map((t, i) => (
          <li data-reveal><span class="mono mv">{i + 1}.</span><span class="yr">{t.year}</span><span class="tt">{t.title}<em class="mono">{t.place}</em></span></li>
        ))}
      </ol>
      <div class="about-seal"><Seal /></div>
    </div>
  </section>

  <!-- ───────────── CERTIFICATES ───────────── -->
  <section class="section" id="certificates">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="square-tag" data-reveal>03 — Certificates</p>
          <h2 class="h2" data-split><span class="gold">Earned, and</span> <span class="accent">verified.</span></h2>
        </div>
        <a class="btn ghost" href={url('/certificates/')} data-reveal data-magnetic>All certificates <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="cert-row">
        {certs.slice(0, 3).map((c) => (
          <a class="cert-card" href={url(`/certificates/${c.id}/`)} data-cursor="Open" data-reveal>
            <div data-tilt><CertificatePaper title={c.data.title} issuer={c.data.issuer} issued={c.data.issued} image={c.data.image} /></div>
            <div class="cert-meta">
              <span class="mono">{c.data.issuer}</span>
              <h3 class="h3">{c.data.title}</h3>
              <span class="mono muted">{formatDate(c.data.issued)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────── SKILLS ───────────── -->
  <section class="marquees" aria-label="Skills" id="skills">
    <div class="wrap skills-head">
      <p class="square-tag" data-reveal>04 — Skills</p>
      <a class="link-line mono" href={url('/skills/')} data-reveal>See all {allSkills.length} skills →</a>
    </div>
    <div class="marquee" data-marquee="left">
      <div class="marquee-track">
        {[0, 1].map(() => allSkills.slice(0, 18).map((s) => <span class="mq-item gold">{s}<i aria-hidden="true">♛</i></span>))}
      </div>
    </div>
    <div class="marquee alt" data-marquee="right">
      <div class="marquee-track">
        {[0, 1].map(() => allSkills.slice(12).concat(allSkills.slice(0, 6)).map((s) => <span class="mq-item">{s}<i aria-hidden="true">01</i></span>))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; z-index: 2; overflow: hidden; min-height: 100svh; padding: 110px 0 50px; display: grid; align-content: center; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(60% 70% at 72% 55%, rgba(201, 165, 94, .10), transparent 70%); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(20px, 3vw, 48px); align-items: center; }
  .hero-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hero-title { font-size: clamp(3.2rem, 6.6vw, 6.6rem); }
  .hl-line { display: block; }
  .hero-intro { margin: 0; }
  .hero-intro strong { color: var(--ink); font-weight: 600; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .hero-status { display: inline-flex; align-items: center; gap: .7em; color: var(--ink-soft); font-size: .68rem; margin: 0; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #D9B064; box-shadow: 0 0 0 4px rgba(217, 176, 100, .2); }
  .hero-visual { display: grid; gap: .6rem; }
  .bq { position: relative; width: 100%; aspect-ratio: 1 / 1.02; touch-action: pan-y; }
  .bq :global(canvas) { position: absolute; inset: 0; cursor: crosshair; }
  .bq-hint { margin: 0; text-align: center; color: var(--ink-soft); font-size: .64rem; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 460px; width: 100%; margin: 0 auto; }
    .hero { padding-top: 90px; }
  }

  .about-strip { position: relative; z-index: 2; overflow: hidden; }
  .about-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 90px); align-items: center; }
  .about-copy { display: grid; gap: 1.3rem; justify-items: start; }
  .about-copy .lead { margin: 0; }
  .moves { list-style: none; margin: 0; padding: 0; }
  .moves li { display: grid; grid-template-columns: 2.4rem 5rem 1fr; align-items: baseline; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  .mv { color: var(--blue); }
  .yr { font-family: var(--serif); font-style: italic; font-size: 1.8rem; color: #E2C98A; line-height: 1; }
  .tt { font-family: var(--serif); font-size: 1.35rem; line-height: 1.2; display: grid; gap: .25rem; }
  .tt em { font-style: normal; color: var(--ink-soft); font-size: .62rem; }
  .about-seal { position: absolute; right: -20px; top: -40px; opacity: .9; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } .about-seal { display: none; } }

  .cert-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 3vw, 36px); }
  .cert-card { display: grid; gap: 1.2rem; }
  .cert-meta { display: grid; gap: .35rem; }
  .cert-meta .mono { color: var(--burgundy); font-size: .68rem; }
  .cert-meta .muted { color: var(--ink-soft); }
  @media (max-width: 860px) { .cert-row { grid-template-columns: 1fr; max-width: 520px; } }

  .marquees { padding: clamp(30px, 5vw, 60px) 0 clamp(70px, 9vw, 120px); overflow: hidden; display: grid; gap: .4rem; }
  .skills-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
  .marquee { overflow: hidden; white-space: nowrap; }
  .marquee.alt { background: var(--espresso); color: var(--beige); padding: .5rem 0; transform: rotate(-1.5deg); margin: .6rem -2vw 0; }
  .marquee-track { display: inline-flex; will-change: transform; }
  .mq-item { display: inline-flex; align-items: center; gap: .5em; font-family: var(--serif); font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: 1.15; padding-right: .5em; }
  .mq-item i { font-style: normal; font-size: .45em; color: var(--burgundy); -webkit-text-fill-color: var(--burgundy); }
  .marquee.alt .mq-item { font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-style: italic; }
  .marquee.alt .mq-item i { font-family: var(--mono); font-size: .5em; color: var(--blue); -webkit-text-fill-color: var(--blue); }
</style>
