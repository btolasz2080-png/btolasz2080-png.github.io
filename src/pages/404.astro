---
import Base from '../layouts/Base.astro';
import Piece from '../components/Piece.astro';
import { url } from '../lib/url';
---
<Base title="Illegal move" footer={false}>
  <section class="nf">
    <div class="wrap nf-inner">
      <div class="nf-queen" data-tilt><Piece type="queen" tone="gold" /></div>
      <p class="square-tag">404 — Illegal move</p>
      <h1 class="display"><span class="gold">That square</span> <span class="accent">doesn't exist.</span></h1>
      <a class="btn" href={url('/')} data-magnetic>Back to the board <span class="arrow">→</span></a>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-items: center; padding: 120px 0 60px; text-align: center; }
  .nf-inner { display: grid; justify-items: center; gap: 1.6rem; }
  .nf-queen { width: 90px; }
</style>
